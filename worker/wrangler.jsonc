{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steal-an-egg-reports",
  "account_id": "84847e5704373fb35830333471b96bbd",
  "main": "index.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "JIRA_WEBSITE_AUTO_ENABLED": "false",
    "ALLOWED_ORIGIN": "https://djorchard.github.io",
    "TURNSTILE_HOSTNAME": "djorchard.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "steal-an-egg-reports",
    "database_id": "7f115607-24a6-40e5-a1ec-c6dc7c555b15"
  }],
  "ratelimits": [{
    "name": "REPORT_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
